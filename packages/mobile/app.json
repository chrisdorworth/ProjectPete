{
  "expo": {
    "name": "Meridian",
    "slug": "meridian-mobile",
    "version": "0.1.0",
    "scheme": "meridian",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1B2D"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meridian.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Meridian uses the camera for profile photos.",
        "NSContactsUsageDescription": "Meridian accesses contacts to match leads."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1B2D"
      },
      "package": "com.meridian.mobile",
      "permissions": ["CAMERA", "READ_CONTACTS"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F1B2D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
