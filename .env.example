# ──────────────────────────────────────────────
# Project Meridian — Environment Variables
# Copy to .env and fill in values
# ──────────────────────────────────────────────

# ── Database ──
DATABASE_URL="postgresql://meridian:meridian_dev@localhost:5432/meridian?schema=public"
DATABASE_EVENT_STORE_URL="postgresql://meridian:meridian_dev@localhost:5432/meridian_events?schema=public"

# ── Redis ──
REDIS_URL="redis://localhost:6379"

# ── Neo4j ──
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="meridian_dev"

# ── Auth ──
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"
JWT_EXPIRY="24h"
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ── Claude API ──
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-4-20250514"

# ── Enrichment Providers ──
APOLLO_API_KEY=""
HUNTER_API_KEY=""
CLEARBIT_API_KEY=""
WHITEPAGES_API_KEY=""
PIPL_API_KEY=""
BOMBORA_API_KEY=""

# ── Outreach ──
POSTMARK_SERVER_TOKEN=""
POSTMARK_FROM_EMAIL=""
SLYBROADCAST_USER=""
SLYBROADCAST_PASS=""
BOND_API_KEY=""

# ── Proxy ──
PROXY_HOST=""
PROXY_PORT=""
PROXY_USER=""
PROXY_PASS=""

# ── ML Service ──
ML_SERVICE_URL="http://localhost:8000"

# ── Monitoring ──
GRAFANA_ADMIN_PASSWORD="CHANGE_ME"

# ── App ──
NODE_ENV="development"
PORT=3001
QUERY_PORT=3002
DASHBOARD_PORT=3000
LOG_LEVEL="info"
