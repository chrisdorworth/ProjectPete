FROM node:22-alpine AS base
WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json* ./
COPY packages/domain/package.json ./packages/domain/
COPY packages/query-service/package.json ./packages/query-service/
COPY prisma/schema.prisma ./prisma/
RUN npm ci --workspace=packages/query-service --include-workspace-root

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/domain/node_modules ./packages/domain/node_modules
COPY --from=deps /app/packages/query-service/node_modules ./packages/query-service/node_modules
COPY . .
RUN npx prisma generate --schema=prisma/schema.prisma
RUN npm run build --workspace=packages/domain
RUN npm run build --workspace=packages/query-service

FROM base AS runner
ENV NODE_ENV=production
COPY --from=builder /app/packages/query-service/dist ./packages/query-service/dist
COPY --from=builder /app/packages/query-service/package.json ./packages/query-service/
COPY --from=builder /app/packages/domain/dist ./packages/domain/dist
COPY --from=builder /app/packages/domain/package.json ./packages/domain/
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/prisma ./prisma

EXPOSE 3002
CMD ["node", "packages/query-service/dist/server.js"]
